# Local-only demo credentials. Do not expose database publicly.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sensorpulse
DB_USER=bench
DB_PASSWORD=bench_local_only
PORT=8080
DB_POOL_TOTAL=20
# Pin for real runs (docker buildx imagetools inspect <image> | grep Digest)
PLATFORM=linux/amd64
POSTGRES_IMAGE=postgres:17
K6_IMAGE=grafana/k6:latest

# Auth for the apps: none (default, used by the standard benchmarks) or jwt
AUTH_MODE=none
JWT_SECRET=bench-jwt-secret-local-only
